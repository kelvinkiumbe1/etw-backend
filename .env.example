# ── Copy to .env and fill in (never commit the real .env) ──

# MetaApi.cloud API token (from https://app.metaapi.cloud → Token management)
METAAPI_TOKEN=

# Optional. Leave blank unless MetaApi told you a specific region, e.g. new-york / london / singapore
METAAPI_REGION=
# The two biggest levers on what MetaApi charges per connected account, and the
# ones to read off the pricing table when setting SYNC_TOKENS_PER_HOUR below.
# Both are UNSET, so mt5sync.js falls back to the cheap pair:
#   METAAPI_ACCOUNT_TYPE  cloud-g1 (default) | cloud-g2
#     g1 supports "regular" reliability; g2 is high-reliability only and costs more.
#   METAAPI_RELIABILITY   regular (default) | high
#     "high" runs redundant instances — roughly doubles the per-account cost.
# Leave both unset unless you have a reason: journalling closed trades tolerates a
# brief reconnect, so paying for high reliability buys nothing here.
METAAPI_ACCOUNT_TYPE=
METAAPI_RELIABILITY=

# Firebase service-account JSON for the CLIENT'S Firebase project.
# Firebase console → Project settings → Service accounts → "Generate new private key".
# Paste the whole JSON on one line, OR base64-encode it and paste that.
FIREBASE_SERVICE_ACCOUNT=

# ── cTrader (Spotware Open API) — register an app at https://openapi.ctrader.com ──
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# Must match the Redirect URI you set on the cTrader app, e.g.
# https://YOUR-SERVICE.onrender.com/api/ctrader/callback
CTRADER_REDIRECT_URI=

# TradeLocker & DXtrade need NO app key — users log in with their own credentials
# in the journal UI. (DXtrade's base URL is provided per-connect from the UI.)

# ── Gumroad (subscriptions) ───────────────────────────────────────────
# Access token: Gumroad → Settings → Advanced → Applications → Generate access token
GUMROAD_ACCESS_TOKEN=
# The membership products — paste the permalink (the part after /l/),
# the product id, or the full product URL; all three work.
GUMROAD_PRODUCT_ESSENTIAL=zsjehf
GUMROAD_PRODUCT_PRO=zmoivqx
# Optional: the separate yearly products (grant 366 days per purchase).
GUMROAD_PRODUCT_ESSENTIAL_YEARLY=sjeull
GUMROAD_PRODUCT_PRO_YEARLY=gngojz
# Optional: the separate quarterly products (grant 92 days per purchase).
GUMROAD_PRODUCT_ESSENTIAL_QUARTERLY=wskfqc
GUMROAD_PRODUCT_PRO_QUARTERLY=tphmr
# Also set the Ping URL on Gumroad (Settings → Advanced → Ping) to:
#   https://YOUR-SERVICE.onrender.com/api/gumroad/ping

# Local port (Render sets PORT automatically; ignored there)
PORT=8080

# ── ETW University ─────────────────────────────────────────────
# Mentor allowlist: comma-separated emails. Users on this list get the
# mentor dashboard on etw-university.html. Managed here — no code changes.
MENTOR_EMAILS=
# Frontend URL used in notification links (defaults to https://etwiz.space)
ETW_SITE_URL=

# ── AUTO-SYNC TOKENS (metered MT5 direct connect) ──────────────────
# Direct connect is metered, not subscribed: MetaApi bills per deployed account
# per hour, and the first connect costs more because the whole history is pulled
# down. Users hold a prepaid token balance; src/tokens.js debits it as sync runs.
#
# RATES — retune these without a code change. Derived as:
#   tokenPrice       = packPrice / packTokens          ($10 / 2500 = $0.004)
#   SYNC_TOKENS_PER_HOUR    = ceil(metaApiHourly * margin / tokenPrice)
#   SYNC_TOKENS_PER_CONNECT = ceil(metaApiFirstSync * margin / tokenPrice)
# VERIFIED from MetaApi's rate page for this config (cloud-g1, regular
# reliability, paid subscription) against the live Selar pack:
#   deployed hosting         $0.019688 /account/hour
#   undeployed hosting       $0.00105  /account/hour   (19x cheaper — why we undeploy)
#   per deployment           $0.118125 each deploy
#   adding a unique account  $2.10     once per CALENDAR MONTH per platform+server+login
#   MetaApi API calls        $0
#   token price              KSh 1,250 / 2,500 = KSh 0.50 ~ $0.00388
# => ceil(0.019688*1.5/0.00388)=8 per hour, ceil(2.10*1.5/0.00388)=812 -> 800 per connect
# An always-on account costs us ~$16.60/mo, so 24/7 sync cannot be sold below that.
SYNC_TOKENS_PER_HOUR=8
SYNC_TOKENS_PER_CONNECT=800
# Daily mode is billed PER PULL, not per hour: one deploy ($0.118125) plus a few
# minutes of hosting, then undeployed. ceil(0.123047*1.5/0.00388)=48.
SYNC_TOKENS_PER_PULL=48
# How often daily mode pulls. Do NOT lower this much — at $0.118 per deployment,
# pulling hourly costs MORE than just staying connected, so the economics are
# daily-ish or always-on with nothing sensible in between.
SYNC_PULL_EVERY_HOURS=24
# How often the meter sweeps, in minutes. Billing is whole-hours-only regardless,
# so frequent passes are cheap no-ops that keep the anchor honest over restarts.
SYNC_METER_MINUTES=15

# ── SELAR (token pack purchases) ───────────────────────────────────
# Selar is a storefront, not a payments API — no dynamic checkout. Create three
# products, then map each PRODUCT ID to the tokens it grants. This mapping is
# authoritative: never derive tokens from the amount paid, because Selar bills in
# six currencies (NGN/USD/GBP/GHS/KES/ZAR) and the same pack arrives as a
# different number depending on the buyer's region.
# Format: productId:tokens,productId:tokens,...
SELAR_TOKEN_PRODUCTS=

# Shared secret authenticating the webhook. INVENT a long random value (e.g.
# `openssl rand -hex 32`), set it here, and configure Selar/Zapier to send it as
# the X-ETW-Hook-Secret header. This endpoint MINTS BALANCE — without the secret
# anyone who finds the URL can grant themselves tokens, so the route refuses
# every request while this is unset.
SELAR_HOOK_SECRET=

# Optional. If your Selar admin gives you real API access, put the key here and
# implement verifyRemote() in src/selar.js — re-fetching the transaction is
# strictly stronger than a shared secret, which cannot bind to the payload.
SELAR_API_KEY=

# Set to 1 to log the raw + parsed webhook body for the FIRST real purchase, so
# src/selar.js parse() can be corrected against Selar's actual field names.
# Turn back off afterwards — the body carries buyer PII.
SELAR_DEBUG=

# Delete a user's MetaApi account after this many days of no sync activity.
# An idle registered account costs $0.00105/hr ($0.77/mo); deleting stops that,
# but re-adding costs $2.10 — so break-even is ~3 months and anything shorter
# loses money on returning users. Floor-clamped to 30 days in code.
# Only touches disconnected/depleted/error accounts; 'paused' (weekend) is safe.
SYNC_PRUNE_AFTER_DAYS=90
